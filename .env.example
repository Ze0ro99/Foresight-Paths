# Foresight Paths — server-side environment. Never commit real credentials.
# Copy to .env only for local Docker use.

# Gemini server-side inference.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Pi Developer Portal: registered Pi Testnet app only.
PI_API_KEY=
PI_NETWORK=Pi Testnet
PI_SANDBOX_MODE=false
PI_DIRECT_TESTNET_ENABLED=true
NEXT_PUBLIC_PI_SANDBOX_MODE=false

# Identity-only by default. Payments scope is requested only when explicitly enabled.
NEXT_PUBLIC_PI_PAYMENTS_ENABLED=false

# Public, RLS-protected data reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional elevated Vercel-side private RPC key:
# Modern sb_secret_... or legacy JWT whose decoded role claim is service_role.
# Edge Functions use Supabase's injected SUPABASE_SECRET_KEYS inside their own runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Release gates: keep all false until separate approval and end-to-end Testnet validation.
PI_PAYMENTS_ENABLED=false
PI_PAYMENT_INTENT_LEDGER_READY=false
PI_ENTITLEMENT_LEDGER_ENABLED=false
PI_MAINNET_PAYMENTS_APPROVED=false
