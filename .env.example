# Configure these values in Vercel Project Settings -> Environment Variables.
# Never commit real secrets or paste them into chat.

# Required for AI-powered event analysis.
GEMINI_API_KEY=

# Pi Platform server key. Keep server-side only; never prefix with NEXT_PUBLIC_.
PI_API_KEY=

# Keep true for Pi Testnet/sandbox. Change to false only after explicit Mainnet approval.
PI_SANDBOX_MODE=true

# Must match PI_SANDBOX_MODE. Public because the browser SDK needs the same network mode.
NEXT_PUBLIC_PI_SANDBOX_MODE=true
