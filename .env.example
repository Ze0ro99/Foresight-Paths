# Copy this file to .env for local Docker use. Never commit real credentials.
# Vercel users should set the same names in Project Settings -> Environment Variables.

# Gemini AI analysis (server-only key).
GEMINI_API_KEY=
# Default is a stable low-latency Gemini Flash model. Override only with a model
# identifier available to your Google AI Studio/API key.
GEMINI_MODEL=gemini-3.8-flash

# Pi Platform server key (Testnet app only). Keep server-side.
PI_API_KEY=
PI_NETWORK=Pi Testnet
PI_SANDBOX_MODE=false
PI_DIRECT_TESTNET_ENABLED=true
# Must match PI_SANDBOX_MODE; this public flag is consumed by the Pi browser SDK.
NEXT_PUBLIC_PI_SANDBOX_MODE=false
# Request the Pi payments scope only after both client and server payment gates are deliberately enabled.
NEXT_PUBLIC_PI_PAYMENTS_ENABLED=false

# Foresight Paths isolated Supabase project. Publishable key is public and RLS-protected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only elevated Supabase key: modern sb_secret_... or legacy service_role JWT.
# The app uses apikey only for sb_secret keys and adds Bearer only for legacy JWT keys.
# Never expose using NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Fail-closed release gates. Direct Testnet identity may be enabled, but keep all payment execution disabled.
PI_PAYMENTS_ENABLED=false
PI_PAYMENT_INTENT_LEDGER_READY=false
PI_ENTITLEMENT_LEDGER_ENABLED=false
PI_MAINNET_PAYMENTS_APPROVED=false
